#include <stdio.h>

int main()
{
    int index[100];
    int n, i, block;

    printf("Enter the number of file blocks: ");
    scanf("%d", &n);

    printf("\nEnter the block numbers:\n");

    for (i = 0; i < n; i++)
    {
        printf("Block %d: ", i + 1);
        scanf("%d", &index[i]);
    }

    printf("\nIndexed File Allocation:\n");
    printf("Index Block\n");

    for (i = 0; i < n; i++)
    {
        printf("Entry %d -> Block %d\n", i + 1, index[i]);
    }

    printf("\nEnter the block to access: ");
    scanf("%d", &block);

    if (block < 1 || block > n)
    {
        printf("Invalid block number.\n");
    }
    else
    {
        printf("Index entry %d points to block %d.\n",
               block, index[block - 1]);
    }

    return 0;
}


