#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n, i, search;
    int records[100];

    printf("Enter the number of records: ");
    scanf("%d", &n);

    printf("Enter the records:\n");

    for (i = 0; i < n; i++)
    {
        printf("Record %d: ", i + 1);
        scanf("%d", &records[i]);
    }

    printf("\nRecords stored sequentially:\n");

    for (i = 0; i < n; i++)
    {
        printf("Record %d = %d\n", i + 1, records[i]);
    }

    printf("\nEnter the record number to access: ");
    scanf("%d", &search);

    if (search < 1 || search > n)
    {
        printf("Invalid record number.\n");
    }
    else
    {
        printf("\nAccessing records sequentially:\n");

        for (i = 0; i < search; i++)
        {
            printf("Reading Record %d = %d\n",
                   i + 1, records[i]);
        }

        printf("\nRequested Record %d = %d\n",
               search, records[search - 1]);
    }

    return 0;
}


